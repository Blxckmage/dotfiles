export PATH="/usr/bin:/usr/local/bin:$PATH"

if command -v mise &> /dev/null; then
  mise() {
    unfunction mise
    eval "$(command mise activate zsh)"
    mise "$@"
  }
fi

if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

