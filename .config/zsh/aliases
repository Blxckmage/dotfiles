if command -v win32yank.exe &>/dev/null; then
  cdp() { if (( $# )); then for p in "$@"; do readlink -f "$p"; done | paste -sd " " - | win32yank.exe -i --crlf; else pwd | win32yank.exe -i --crlf; fi; }
  cfp() { readlink -f "${1:-.}" | win32yank.exe -i --crlf; }
elif command -v clip.exe &>/dev/null; then
  cdp() { if (( $# )); then for p in "$@"; do readlink -f "$p"; done | paste -sd " " - | clip.exe; else pwd | clip.exe; fi; }
  cfp() { readlink -f "${1:-.}" | clip.exe; }
elif command -v wl-copy &>/dev/null; then
  cdp() { if (( $# )); then for p in "$@"; do readlink -f "$p"; done | paste -sd " " - | wl-copy; else pwd | wl-copy; fi; }
  cfp() { readlink -f "${1:-.}" | wl-copy; }
elif command -v xclip &>/dev/null; then
  cdp() { if (( $# )); then for p in "$@"; do readlink -f "$p"; done | paste -sd " " - | xclip -selection clipboard; else pwd | xclip -selection clipboard; fi; }
  cfp() { readlink -f "${1:-.}" | xclip -selection clipboard; }
fi

alias ports="lsof -i -P -n | grep LISTEN"  

# Yazi change directory
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Thunar to current directory
function n() { 
  local dir="${1:-$PWD}"
  (nautilus "$dir" &> /dev/null &) # Fix
}

# Open files with xdg-open in the background 
open() (
  xdg-open "$@" >/dev/null 2>&1 &
)
