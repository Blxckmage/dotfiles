#history
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=$HISTSIZE

# sane defaults
setopt inc_append_history share_history hist_ignore_all_dups
setopt autocd no_beep interactivecomments
unsetopt nomatch

# Set complete path
export PATH="./bin:$HOME/.local/bin:$HOME/.local/share/bob/nvim-bin:$PATH"
set +h

# completion (cached - only regenerate if dump is >24h old)
autoload -Uz compinit
local -a _stale_dump
_stale_dump=( ~/.zcompdump(Nmh+24) )
if (( ${#_stale_dump} )); then
  compinit
else
  compinit -C
fi
zstyle ':completion:*' menu select
bindkey -e
